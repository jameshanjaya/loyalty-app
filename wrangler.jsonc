{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loyalty-bos",
  "main": "src/index.ts",
  "placement": { "mode": "smart" },
  "compatibility_date": "2026-11-04",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loyalty-bos",
      // ONLY place the D1 id lives. Swap this one value for the APAC database at deploy. Binding name stays DB.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "BANNERS",
      "bucket_name": "loyalty-banners"
    }
  ],
  "triggers": {
    "crons": ["15 17 * * *"]
  },
  "vars": {
    "WA_BUSINESS_NUMBER": "",
    "WA_VERIFY_TOKEN": "",
    "WA_ACCESS_TOKEN": "",
    "WA_APP_SECRET": "",
    "WA_OTP_ENABLED": ""
  },
  "secrets": {
    "required": ["OWNER_PASSWORD", "TOKEN_SECRET", "PIN_PEPPER", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  }
}
